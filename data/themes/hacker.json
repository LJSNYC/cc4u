{
  "name": "hacker",
  "version": "1.0",
  "tagline": "Matrix green on black with glow",
  "ambient_style": "matrix_rain",
  "corner_decorators": false,
  "colors": {
    "bg_primary": "#000000", "bg_secondary": "#001a00", "bg_widget": "#001a00",
