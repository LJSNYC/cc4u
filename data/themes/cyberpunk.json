{
  "name": "cyberpunk",
  "version": "1.0",
  "tagline": "Hot pink and electric blue neon",
  "ambient_style": "gradient_wave",
  "corner_decorators": false,
  "colors": {
    "bg_primary": "#0a0a1a", "bg_secondary": "#0d0d22", "bg_widget": "#0f0f28",
    "border": "#ff0090", "border_active": "#00d4ff",
