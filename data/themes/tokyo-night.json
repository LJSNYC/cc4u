{
  "name": "tokyo-night",
  "version": "1.0",
  "tagline": "Soft blue-purple, calm and readable",
  "ambient_style": "quote",
  "corner_decorators": false,
  "colors": {
    "bg_primary": "#1a1b26", "bg_secondary": "#16161e", "bg_widget": "#1f2335",
